anchor=bottom-center
text-alignment=center
width=220
height=60
border-size=2
border-radius=16
border-color=#8E8F9180
background-color=#010101a6
text-color=#F7F9FBff
progress-color=source #8E8F91
outer-margin=0, 0, 30, 0
margin=10
padding=8,16
layer=overlay
ignore-timeout=1
default-timeout=1000
format=<b>%s</b>

