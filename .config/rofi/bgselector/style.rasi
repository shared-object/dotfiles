@import "../colors.rasi"

configuration {
    show-icons: true;
    font: "0xProto Nerd Font 10.5, Symbols Nerd Font 10.5";
    dmenu {
        display-name: " 󰸉 Wallpapers ";
    }
}

* {
    font: "0xProto Nerd Font 10.5, Symbols Nerd Font 10.5";
    margin: 0;
    padding: 0;
}

window {
    background-color: @bg;
    text-color: @fg;
    border: 2px;
    border-color: @accent;
    border-radius: 16px;
    width: 960px;
    height: 650px;
    location: center;
    anchor: center;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    spacing: 16px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border: 1.5px;
    border-color: @accent;
    border-radius: 10px;
    padding: 12px 16px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent-bright;
    font: "0xProto Nerd Font Bold 11.5, Symbols Nerd Font 11.5";
    vertical-align: 0.5;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search wallpapers (Gruvbox, Nord, Catppuccin, Dark...)...";
    placeholder-color: @fg-muted;
    font: "0xProto Nerd Font 10.5, Symbols Nerd Font 10.5";
    vertical-align: 0.5;
}

listview {
    background-color: transparent;
    flow: horizontal;
    fixed-columns: true;
    columns: 4;
    lines: 3;
    spacing: 14px;
    cycle: true;
    dynamic: true;
    layout: vertical;
    padding: 4px 0px;
    border: 0px;
}

element {
    background-color: @bg-alt;
    border: 2px;
    border-color: transparent;
    border-radius: 12px;
    orientation: vertical;
    padding: 10px;
    spacing: 8px;
    children: [ element-icon, element-text ];
}

element normal.normal {
    background-color: @bg-alt;
    border-color: transparent;
    text-color: @fg;
}

element normal.active {
    background-color: @bg-alt;
    border-color: transparent;
    text-color: @active;
}

element normal.urgent {
    background-color: @bg-alt;
    border-color: transparent;
    text-color: @urgent;
}

element selected.normal {
    background-color: @selected-bg;
    border-color: @accent-bright;
    text-color: @selected-fg;
}

element selected.active {
    background-color: @selected-bg;
    border-color: @active;
    text-color: @selected-fg;
}

element selected.urgent {
    background-color: @urgent;
    border-color: @urgent;
    text-color: @fg;
}

element alternate.normal {
    background-color: @bg-alt;
    border-color: transparent;
    text-color: @fg;
}

element alternate.active {
    background-color: @bg-alt;
    border-color: transparent;
    text-color: @active;
}

element alternate.urgent {
    background-color: @bg-alt;
    border-color: transparent;
    text-color: @urgent;
}

element-icon {
    background-color: @bg;
    size: 110px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    border-radius: 6px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "0xProto Nerd Font 9.5, Symbols Nerd Font 9.5";
    padding: 4px 0px;
}

element selected element-text {
    background-color: transparent;
    text-color: @selected-fg;
    font: "0xProto Nerd Font Bold 9.5, Symbols Nerd Font 9.5";
}
