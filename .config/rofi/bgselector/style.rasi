@import "../colors.rasi"

configuration {
    show-icons: true;
    dmenu {
        display-name: " 🌌 Wallpaper ";
    }
}

* {
    font: "0xProto Nerd Font 10";
    margin: 0;
    padding: 0;
}

window {
    background-color: #121318;
    text-color: #dcdfe6;
    border: 2px;
    border-color: @accent;
    border-radius: 16px;
    width: 960px;
    height: 650px;
    location: center;
    anchor: center;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    spacing: 16px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: #1b1d24;
    border: 1.5px;
    border-color: #2c2f3b;
    border-radius: 10px;
    padding: 12px 16px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent-bright;
    font: "0xProto Nerd Font Bold 11";
    vertical-align: 0.5;
}

entry {
    background-color: transparent;
    text-color: #ffffff;
    placeholder: "Search wallpapers (Gruvbox, Nord, Catppuccin, Dark...)...";
    placeholder-color: #6b7280;
    font: "0xProto Nerd Font 10.5";
    vertical-align: 0.5;
}

listview {
    background-color: transparent;
    flow: horizontal;
    fixed-columns: true;
    columns: 4;
    lines: 3;
    spacing: 14px;
    cycle: true;
    dynamic: true;
    layout: vertical;
    padding: 4px 0px;
}

element {
    background-color: #181a21;
    border: 2px;
    border-color: #242733;
    border-radius: 12px;
    orientation: vertical;
    padding: 10px;
    spacing: 8px;
    children: [ element-icon, element-text ];
}

element selected {
    background-color: #252836;
    border-color: @accent;
}

element-icon {
    background-color: #0e0f13;
    size: 110px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    border-radius: 6px;
}

element-text {
    background-color: transparent;
    text-color: #dcdfe6;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "0xProto Nerd Font 9.5";
    padding: 4px 0px;
}

element selected element-text {
    background-color: transparent;
    text-color: #ffffff;
    font: "0xProto Nerd Font Bold 9.5";
}
