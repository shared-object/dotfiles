@import "../colors.rasi"

configuration {
    show-icons: true;
    dmenu {
        display-name: " 🌌 Wallpaper ";
    }
}

* {
    font: "0xProto Nerd Font 10";
    margin: 0;
    padding: 0;

    background:                  #121318;
    background-color:            transparent;
    foreground:                  #dcdfe6;
    text-color:                  #dcdfe6;

    normal-background:           #181a21;
    normal-foreground:           #dcdfe6;
    alternate-normal-background: #181a21;
    alternate-normal-foreground: #dcdfe6;
    selected-normal-background:  #282c37;
    selected-normal-foreground:  #ffffff;

    active-background:           #181a21;
    active-foreground:           @accent;
    alternate-active-background: #181a21;
    alternate-active-foreground: @accent;
    selected-active-background:  #282c37;
    selected-active-foreground:  #ffffff;

    urgent-background:           #181a21;
    urgent-foreground:           #e06c75;
    alternate-urgent-background: #181a21;
    alternate-urgent-foreground: #e06c75;
    selected-urgent-background:  #282c37;
    selected-urgent-foreground:  #ffffff;
}

window {
    background-color: #121318;
    text-color: #dcdfe6;
    border: 2px;
    border-color: @accent;
    border-radius: 16px;
    width: 960px;
    height: 650px;
    location: center;
    anchor: center;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    spacing: 16px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: #1b1d24;
    border: 1.5px;
    border-color: #2c2f3b;
    border-radius: 10px;
    padding: 12px 16px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent-bright;
    font: "0xProto Nerd Font Bold 11";
    vertical-align: 0.5;
}

entry {
    background-color: transparent;
    text-color: #ffffff;
    placeholder: "Search wallpapers (Gruvbox, Nord, Catppuccin, Dark...)...";
    placeholder-color: #6b7280;
    font: "0xProto Nerd Font 10.5";
    vertical-align: 0.5;
}

listview {
    background-color: transparent;
    flow: horizontal;
    fixed-columns: true;
    columns: 4;
    lines: 3;
    spacing: 14px;
    cycle: true;
    dynamic: true;
    layout: vertical;
    padding: 4px 0px;
    border: 0px;
}

element {
    background-color: #181a21;
    border: 2px;
    border-color: #242733;
    border-radius: 12px;
    orientation: vertical;
    padding: 10px;
    spacing: 8px;
    children: [ element-icon, element-text ];
}

element normal.normal {
    background-color: #181a21;
    border-color: #242733;
    text-color: #dcdfe6;
}

element normal.active {
    background-color: #181a21;
    border-color: #242733;
    text-color: @accent;
}

element normal.urgent {
    background-color: #181a21;
    border-color: #242733;
    text-color: #e06c75;
}

element selected.normal {
    background-color: #282c37;
    border-color: @accent;
    text-color: #ffffff;
}

element selected.active {
    background-color: #282c37;
    border-color: @accent;
    text-color: #ffffff;
}

element selected.urgent {
    background-color: #282c37;
    border-color: #e06c75;
    text-color: #ffffff;
}

element alternate.normal {
    background-color: #181a21;
    border-color: #242733;
    text-color: #dcdfe6;
}

element alternate.active {
    background-color: #181a21;
    border-color: #242733;
    text-color: @accent;
}

element alternate.urgent {
    background-color: #181a21;
    border-color: #242733;
    text-color: #e06c75;
}

element-icon {
    background-color: #0e0f13;
    size: 110px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    border-radius: 6px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "0xProto Nerd Font 9.5";
    padding: 4px 0px;
}

element selected element-text {
    background-color: transparent;
    text-color: #ffffff;
    font: "0xProto Nerd Font Bold 9.5";
}
