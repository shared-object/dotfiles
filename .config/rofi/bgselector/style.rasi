@import "../colors.rasi"

configuration {
    show-icons: true;
    dmenu {
        display-name: " 🌌 Wallpaper ";
    }
}

* {
    font: "0xProto Nerd Font 10";
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
}

window {
    transparency: "real";
    background-color: rgba(15, 17, 23, 0.94);
    border: 2px;
    border-color: @accent;
    border-radius: 18px;
    width: 980px;
    height: 660px;
    location: center;
    anchor: center;
    padding: 24px;
}

mainbox {
    spacing: 18px;
    children: [ inputbar, listview ];
}

inputbar {
    spacing: 12px;
    padding: 12px 18px;
    background-color: rgba(0, 0, 0, 0.55);
    border: 1.5px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent-bright;
    font: "0xProto Nerd Font Bold 11";
    vertical-align: 0.5;
}

entry {
    text-color: @fg;
    placeholder: "Search wallpaper by name or category (Gruvbox, Nord, Catppuccin, Dark, Light...)...";
    placeholder-color: rgba(220, 220, 220, 0.45);
    font: "0xProto Nerd Font 10.5";
    vertical-align: 0.5;
}

listview {
    flow: horizontal;
    fixed-columns: true;
    columns: 4;
    lines: 3;
    spacing: 16px;
    cycle: true;
    dynamic: true;
    layout: vertical;
    padding: 4px 0px;
}

element {
    orientation: vertical;
    padding: 10px;
    border-radius: 14px;
    background-color: rgba(0, 0, 0, 0.40);
    border: 2px;
    border-color: rgba(255, 255, 255, 0.08);
    spacing: 8px;
    children: [ element-icon, element-text ];
}

element selected {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: @accent;
}

element-icon {
    size: 115px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.3);
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: @fg;
    font: "0xProto Nerd Font 9.5";
    padding: 4px 6px;
}

element selected element-text {
    text-color: @accent-bright;
    font: "0xProto Nerd Font Bold 9.5";
}
