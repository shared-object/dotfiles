anchor=bottom-center
text-alignment=center
width=220
height=60
border-size=2
border-radius=16
border-color={{color4}}80
background-color={{background}}a6
text-color={{foreground}}ff
progress-color=source {{color4}}
outer-margin=0, 0, 30, 0
margin=10
padding=8,16
layer=overlay
ignore-timeout=1
default-timeout=1000
format=<b>%s</b>

