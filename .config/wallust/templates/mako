# ==============================================================================
# Mako notification daemon configuration (Material Translucent theme)
# Templated by Wallust
# ==============================================================================

# [ GENERAL OPTIONS ]
max-history=10
markup=1
actions=1
history=1
default-timeout=5000
sort=+time
max-visible=5
layer=overlay
anchor=top-right

# [ BINDINGS ]
on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss
on-touch=invoke-default-action

# [ MATERIAL STYLE & GEOMETRY ]
font=0xProto Nerd Font 10
width=360
height=180
margin=12
outer-margin=0
padding=14,16

# Translucent surface (~70% opacity for distinct glass look) & rounded Material cards
background-color={{background}}b3
text-color={{foreground}}ff
border-color={{color4}}b3
border-size=2
border-radius=14
progress-color=source {{color4}}

# [ ICONS ]
icons=1
max-icon-size=48
icon-location=left

# [ FORMATTING ]
format=<b>%s</b>\n%b
text-alignment=left

# ------------------------------------------------------------------------------
# Urgencies
# ------------------------------------------------------------------------------
[urgency=low]
background-color={{background}}99
text-color={{color7}}ff
border-color={{color8}}80
default-timeout=3000

[urgency=normal]
background-color={{background}}b3
text-color={{foreground}}ff
border-color={{color4}}b3
default-timeout=5000

[urgency=high]
background-color={{background}}cc
text-color={{color1}}ff
border-color={{color1}}ff
default-timeout=0

[urgency=critical]
background-color={{background}}d9
text-color={{color1}}ff
border-color={{color1}}ff
default-timeout=0

# ------------------------------------------------------------------------------
# On-Screen Display (OSD) Sliders / Popups
